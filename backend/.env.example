NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rockstar
DB_USER=postgres
DB_PASSWORD=your_postgres_password

CLIENT_URL=http://localhost:5173

MUSIC_UPLOAD_MAX_FILE_SIZE_MB=50
IMAGE_UPLOAD_MAX_FILE_SIZE_MB=5
CATALOG_DEFAULT_PAGE_SIZE=20
CATALOG_MAX_PAGE_SIZE=100

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_SALT_ROUNDS=12

REFRESH_COOKIE_NAME=rockstar_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEV_EXPOSE_RESET_LINK=false

# Optional. Set only when running behind a real reverse proxy/load balancer
# (e.g. Nginx, a cloud load balancer) so Express trusts X-Forwarded-* headers
# for req.ip/req.secure. "true" trusts one hop; leave unset in local dev.
# TRUST_PROXY=true
