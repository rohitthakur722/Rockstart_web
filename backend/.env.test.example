# Copy to backend/.env.test and adjust DB_USER/DB_PASSWORD for your local
# PostgreSQL install. backend/.env.test is gitignored — never commit it.
#
# This file is loaded ONLY by the test bootstrap (tests/setup/loadTestEnv.js)
# and is completely separate from backend/.env (your real development file,
# untouched by any of this). DB_NAME must always end in "_test" — the test
# suite's safety guard (tests/helpers/assertTestDatabase.js) refuses to run
# any destructive operation otherwise.

NODE_ENV=test
PORT=0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rockstar_test
DB_USER=postgres
DB_PASSWORD=your_test_postgres_password

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=test_access_secret_with_sufficient_length_only_for_tests
JWT_REFRESH_SECRET=test_refresh_secret_with_sufficient_length_only_for_tests
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_SALT_ROUNDS=10

REFRESH_COOKIE_NAME=rockstar_test_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEV_EXPOSE_RESET_LINK=false
TEST_EXPOSE_RESET_LINK=true

MUSIC_UPLOAD_MAX_FILE_SIZE_MB=10
IMAGE_UPLOAD_MAX_FILE_SIZE_MB=2
CATALOG_DEFAULT_PAGE_SIZE=10
CATALOG_MAX_PAGE_SIZE=50

TEST_UPLOAD_ROOT=tests/.tmp/uploads
