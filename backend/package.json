{
  "name": "rockstar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Rockstar music player API server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql -d \"${DB_NAME:-rockstar}\" -f database/schema.sql",
    "db:seed": "psql -d \"${DB_NAME:-rockstar}\" -f database/seed.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "music-metadata": "^11.14.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
