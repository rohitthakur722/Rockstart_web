{
  "name": "rockstar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Rockstar music player API server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql -d \"${DB_NAME:-rockstar}\" -f database/schema.sql",
    "db:seed": "psql -d \"${DB_NAME:-rockstar}\" -f database/seed.sql",
    "uploads:cleanup": "node scripts/cleanupOrphanUploads.js",
    "uploads:cleanup:delete": "node scripts/cleanupOrphanUploads.js --delete",
    "demo:music": "node scripts/setupDemoMusic.js",
    "demo:seed": "node scripts/seedDemoLibrary.js",
    "demo:status": "node scripts/seedDemoLibrary.js --status",
    "demo:reset": "node scripts/seedDemoLibrary.js --reset",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch '<rootDir>/tests/sample10.test.js' --runInBand",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:10": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch '<rootDir>/tests/sample10.test.js' --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:detect-open-handles": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "test:db:create": "node tests/setup/createTestDatabase.js",
    "test:db:reset": "node tests/setup/resetTestDatabase.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "music-metadata": "^11.14.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
